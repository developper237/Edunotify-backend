# ══════════════════════════════════════════════════════════════════
# EduNotify Backend — Variables d'environnement
# Copiez ce fichier en `.env` à la racine du repo puis remplissez les valeurs.
# ══════════════════════════════════════════════════════════════════

# ── Infrastructure (Docker) ──────────────────────────────────────
POSTGRES_USER=edunotify
POSTGRES_PASSWORD=change_me_postgres
POSTGRES_DB=edunotify
REDIS_PASSWORD=change_me_redis
RABBITMQ_USER=edunotify
RABBITMQ_PASSWORD=change_me_rabbit

# ── JWT ─────────────────────────────────────────────────────────
# Générez des secrets longs et aléatoires, ex: openssl rand -hex 64
JWT_SECRET=change_me_jwt_secret
JWT_REFRESH_SECRET=change_me_jwt_refresh_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Email (transactions, OTP, notifications) ────────────────────
GMAIL_USER=votre.email@gmail.com
GMAIL_APP_PASSWORD=votre_mot_de_passe_application

# ── Application ─────────────────────────────────────────────────
APP_NAME=EduNotify
APP_URL=http://localhost:8080

# ── Firebase (notifications push — notification-service & presence-service)
# À générer dans Firebase Console → Paramètres du projet → Comptes de service
# ⚠️ JAMAIS de fichier JSON de service account commité dans le repo !
FIREBASE_PROJECT_ID=smartcampus-6d557
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxx@smartcampus-6d557.iam.gserviceaccount.com

# ── Chatbot (Gemini) ────────────────────────────────────────────
GEMINI_API_KEY=change_me_gemini_api_key

# ── Billing / CinetPay (MTN MoMo, Orange Money) ─────────────────
# À créer sur https://cinetpay.com (compte marchand) → section API
CINETPAY_API_KEY=change_me_cinetpay_api_key
CINETPAY_SITE_ID=change_me_cinetpay_site_id
# URL publique que CinetPay appelle pour confirmer le paiement (IPN)
CINETPAY_NOTIFY_URL=https://votre-domaine.com/billing/webhooks/cinetpay
# URL de retour après paiement (mobile/backend)
CINETPAY_RETURN_URL=https://votre-domaine.com/billing/retour

# ── Gateway / CORS ──────────────────────────────────────────────
# '*' pour tout autoriser, ou liste d'origines séparées par des virgules
CORS_ORIGIN=*
