// shared/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
  output   = "../../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  super_admin
  admin
  chef_departement
  professeur
  delegue
  etudiant
}

enum StatutCompte {
  actif
  inactif
  premier_login
  suspendu
}

enum Plan {
  free
  premium
  pro
  institution
}

enum Formation {
  FI
  FA
}

enum Niveau {
  L1
  L2
  L3
  M1
  M2
}

enum TypeSeance {
  Cours
  TD
  TP
  Examen
  Rattrapage
}

enum StatutPresence {
  present
  absent
}

enum CategorieNotif {
  administratif
  examen
  resultat
  cours
  sondage
}

enum StatutRequete {
  en_attente
  traitee
  rejetee
}

enum StatutAbonnement {
  essai
  actif
  expire
  annule
  impaye
}

enum CycleFacturation {
  mensuel
  annuel
}

enum StatutFacture {
  en_attente
  payee
  echouee
  remboursee
}

enum MethodePaiement {
  mtn_momo
  orange_money
}

model Etablissement {
  id        String   @id @default(cuid())
  nom       String
  ville     String
  plan      Plan     @default(free)
  actif     Boolean  @default(true)
  logoUrl   String?
  gpsLat    Float?
  gpsLng    Float?
  gpsRayon  Int      @default(200)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  departements   Departement[]
  users          User[]
  notifications  Notification[]
  abonnement     Subscription?
  factures       Invoice[]
  documents      Document[]
  sessionsExamen SessionExamen[]
  groupesChat    GroupeChat[]
  conversationsPrivees ConversationPrivee[]
}

model Departement {
  id              String   @id @default(cuid())
  nom             String
  description     String?
  etablissementId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  etablissement Etablissement @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  classes       Classe[]
  chefs         User[]        @relation("ChefDepartement")
  matieres      Matiere[]
}

model Classe {
  id            String    @id @default(cuid())
  nom           String
  filiere       String
  niveau        Niveau
  formation     Formation
  codeGenere    String    @unique
  departementId String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  departement  Departement        @relation(fields: [departementId], references: [id], onDelete: Cascade)
  etudiants    User[]             @relation("EtudiantClasse")
  delegues     User[]             @relation("DelegueClasse")
  sessions     SessionPresence[]
  matieres     Matiere[]          @relation("MatiereClasse")
  publications PublicationNotes[]
}

model User {
  id                 String       @id @default(cuid())
  nom                String
  prenom             String
  email              String       @unique
  passwordHash       String
  role               Role
  statut             StatutCompte @default(premier_login)
  matricule          String?      @unique
  fcmToken           String?
  biometrieActivee   Boolean      @default(false)
  etablissementId    String?
  departementId      String?
  classeEtudiantId   String?
  classeDelegueId    String?
  filieres           Json? // ["Informatique", "Génie Logiciel"]
  matieresEnseignees Json? // ["Algorithmique", "Base de données"]
  photoUrl           String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  etablissement   Etablissement? @relation(fields: [etablissementId], references: [id])
  departementChef Departement?   @relation("ChefDepartement", fields: [departementId], references: [id])
  // AVANT : pas de onDelete précisé -> défaut SetNull -> la suppression
  // d'une Classe détachait juste l'utilisateur (classeEtudiantId/classeDelegueId
  // remis à null) au lieu de le supprimer.
  // APRES : onDelete: Cascade -> supprimer la Classe supprime aussi
  // automatiquement l'utilisateur (étudiant/délégué) qui lui est rattaché.
  classeEtudiant  Classe?        @relation("EtudiantClasse", fields: [classeEtudiantId], references: [id], onDelete: Cascade)
  classeDelegue   Classe?        @relation("DelegueClasse", fields: [classeDelegueId], references: [id], onDelete: Cascade)

  presences             Presence[]
  passwordResetCodes    PasswordResetCode[]
  notificationsEnvoyees Notification[]             @relation("NotifExpediteur")
  notificationsRecues   NotificationDestinataire[]
  voteSondages          VoteSondage[]
  refreshTokens         RefreshToken[]
  notes                 Note[]                     @relation("EtudiantNotes")
  notesSaisies          Note[]                     @relation("NotesSaisies")
  requetes              RequeteNote[]              @relation("EtudiantRequetes")
  requetesTraitees      RequeteNote[]              @relation("RequetesTraitees")
  publications          PublicationNotes[]         @relation("PublicationAuteur")
  chatMessages          ChatMessage[]
  documents             Document[]
  sessionsExamen        SessionExamen[]
  participantsExamen    ParticipantExamen[]
  groupesChatCrees      GroupeChat[]
  membresGroupes        MembreGroupe[]
  messagesGroupes       MessageGroupe[]
  conversationsPrivees  ConversationPrivee[]  @relation("ConversationInitiateur")
  conversationsRecues   ConversationPrivee[]  @relation("ConversationInvite")
  messagesPrives        MessagePrive[]
}

// ── Code de réinitialisation de mot de passe (OTP par email) ─────
model PasswordResetCode {
  id         String   @id @default(cuid())
  userId     String
  codeHash   String
  expiresAt  DateTime
  tentatives Int      @default(0)
  utilise    Boolean  @default(false)
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SessionPresence {
  id           String     @id @default(cuid())
  code         String     @unique
  matiere      String
  professeur   String
  salle        String
  type         TypeSeance
  classeId     String
  delegueId    String
  ouverteLe    DateTime   @default(now())
  fermeeLe     DateTime?
  dureeMinutes Int        @default(5)
  actif        Boolean    @default(true)
  gpsLat       Float?
  gpsLng       Float?
  rayonMetres  Int?
  createdAt    DateTime   @default(now())

  // AVANT : pas de onDelete précisé sur un champ requis -> défaut Restrict
  // -> impossible de supprimer une Classe dès qu'une séance existait pour elle.
  // APRES : onDelete: Cascade -> supprimer la Classe supprime aussi ses
  // séances de présence (qui elles-mêmes suppriment déjà en cascade les
  // Presence associées, cf. le modèle Presence ci-dessous).
  classe    Classe     @relation(fields: [classeId], references: [id], onDelete: Cascade)
  presences Presence[]

  @@index([classeId, actif])
  @@index([delegueId, actif])
}

model Presence {
  id          String         @id @default(cuid())
  sessionId   String
  userId      String
  statut      StatutPresence @default(present)
  confirmeA   DateTime       @default(now())
  methode     String         @default("otp")
  etudiantLat Float?
  etudiantLng Float?
  distanceM   Int?
  deviceId    String?

  session SessionPresence @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
}

model Notification {
  id              String         @id @default(cuid())
  titre           String
  contenu         String
  categorie       CategorieNotif @default(administratif)
  urgence         Boolean        @default(false)
  // AVANT : String (requis) sans onDelete -> défaut Restrict -> impossible
  // de supprimer un utilisateur (étudiant/délégué) tant qu'il avait envoyé
  // au moins une notification, ce qui bloquait toute la suppression en
  // cascade d'une classe.
  // APRES : String? (optionnel) + onDelete: SetNull -> la notification
  // reste visible pour ses destinataires, mais expediteurId passe à null
  // si l'expéditeur est supprimé.
  expediteurId    String?
  etablissementId String?
  estSondage      Boolean        @default(false)
  createdAt       DateTime       @default(now())

  expediteur       User?                      @relation("NotifExpediteur", fields: [expediteurId], references: [id], onDelete: SetNull)
  etablissement    Etablissement?             @relation(fields: [etablissementId], references: [id])
  destinataires    NotificationDestinataire[]
  questionsSondage QuestionSondage[]
  choixSondage     ChoixSondage[]             @relation("NotificationChoix")
}

model QuestionSondage {
  id             String  @id @default(cuid())
  notificationId String
  texte          String
  ordre          Int     @default(0)
  obligatoire    Boolean @default(false)

  notification Notification   @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  choixSondage ChoixSondage[] @relation("QuestionChoix")

  @@index([notificationId, ordre])
}

model NotificationDestinataire {
  id             String    @id @default(cuid())
  notificationId String
  userId         String
  lue            Boolean   @default(false)
  lueLe          DateTime?

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([notificationId, userId])
  @@index([userId, lue])
}

model ChoixSondage {
  id             String @id @default(cuid())
  questionId     String
  notificationId String
  texte          String
  ordre          Int    @default(0)

  question     QuestionSondage @relation("QuestionChoix", fields: [questionId], references: [id], onDelete: Cascade)
  notification Notification    @relation("NotificationChoix", fields: [notificationId], references: [id], onDelete: Cascade)
  votes        VoteSondage[]

  @@index([questionId, ordre])
}

model VoteSondage {
  id      String   @id @default(cuid())
  choixId String
  userId  String
  voteLe  DateTime @default(now())

  choix ChoixSondage @relation(fields: [choixId], references: [id], onDelete: Cascade)
  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([choixId, userId])
}

model Matiere {
  id            String   @id @default(cuid())
  nom           String
  coefficient   Int      @default(1)
  classeId      String?
  departementId String?
  createdAt     DateTime @default(now())

  classe      Classe?       @relation("MatiereClasse", fields: [classeId], references: [id], onDelete: Cascade)
  departement Departement?  @relation(fields: [departementId], references: [id], onDelete: Cascade)
  notes       Note[]
  requetes    RequeteNote[]
}

// ── Publication de notes (session d'évaluation) ──────────────────
// Exemples de titres :
//   "Résultats examens session normale S1"
//   "Résultats TP Algorithmique S2"
//   "Résultats rattrapage S1"
model PublicationNotes {
  id        String   @id @default(cuid())
  titre     String // titre libre donné par le chef
  semestre  String // "Semestre 1" ou "Semestre 2"
  classeId  String
  publiePar String // id du chef de département
  publieLe  DateTime @default(now())
  createdAt DateTime @default(now())

  classe   Classe        @relation(fields: [classeId], references: [id], onDelete: Cascade)
  auteur   User          @relation("PublicationAuteur", fields: [publiePar], references: [id])
  notes    Note[]
  requetes RequeteNote[]
}

model Note {
  id            String   @id @default(cuid())
  valeur        Float?
  noteMax       Float    @default(20)
  publiee       Boolean  @default(false)
  commentaire   String?
  matiereId     String
  etudiantId    String
  saisieParId   String?
  publicationId String? // lien vers la publication
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  matiere     Matiere           @relation(fields: [matiereId], references: [id], onDelete: Cascade)
  etudiant    User              @relation("EtudiantNotes", fields: [etudiantId], references: [id], onDelete: Cascade)
  saisiepar   User?             @relation("NotesSaisies", fields: [saisieParId], references: [id])
  publication PublicationNotes? @relation(fields: [publicationId], references: [id])
  requetes    RequeteNote[]

  // Une note par matière par étudiant PAR publication
  // (pas de contrainte unique globale — plusieurs sessions possibles)
}

model RequeteNote {
  id            String        @id @default(cuid())
  motif         String
  statut        StatutRequete @default(en_attente)
  reponse       String?
  noteId        String? // ← optionnel (null si note absente)
  publicationId String? // ← nouveau : pour les notes absentes
  matiereId     String
  etudiantId    String
  traiteeParId  String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  note        Note?             @relation(fields: [noteId], references: [id], onDelete: Cascade)
  publication PublicationNotes? @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  matiere     Matiere           @relation(fields: [matiereId], references: [id])
  etudiant    User              @relation("EtudiantRequetes", fields: [etudiantId], references: [id])
  traiteepar  User?             @relation("RequetesTraitees", fields: [traiteeParId], references: [id])
}

model ChatMessage {
  id        String   @id @default(cuid())
  text      String
  isUser    Boolean
  createdAt DateTime @default(now())
  userId    String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// ──────────────────────────────────────────────────────────────────
// FACTURATION & ABONNEMENTS
// ──────────────────────────────────────────────────────────────────
// Catalogue des offres. Tarification par taille d'établissement
// (maxEtudiants = null signifie effectif illimité).
model BillingPlan {
  id              String   @id @default(cuid())
  code            Plan     @unique
  nom             String
  description     String?
  maxEtudiants    Int? // null = illimité
  prixMensuelXAF  Int
  prixAnnuelXAF   Int
  fonctionnalites Json?
  actif           Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  abonnements Subscription[]
}

// Abonnement actuel d'un établissement (un seul par établissement).
model Subscription {
  id                 String           @id @default(cuid())
  etablissementId    String           @unique
  planCode           Plan
  statut             StatutAbonnement @default(essai)
  cycle              CycleFacturation @default(mensuel)
  essaiJusqua        DateTime? // fin de l'essai gratuit (14 jours)
  debutPeriode       DateTime? // début de la période payée
  finPeriode         DateTime? // fin de la période payée
  prixXAF            Int? // montant facturé par période
  renouvellementAuto Boolean          @default(true)
  annuleLe           DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  etablissement Etablissement @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  plan          BillingPlan   @relation(fields: [planCode], references: [code])
  factures      Invoice[]

  @@index([statut])
}

// Facture émise pour une période d'abonnement.
// ── Demandes de création d'établissement (landing page) ─────────
model Lead {
  id               String     @id @default(cuid())
  etablissementNom String
  ville            String
  prenomAdmin      String
  nomAdmin         String
  emailAdmin       String
  plan             Plan       @default(pro)
  statut           LeadStatut @default(nouveau)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@index([statut, createdAt])
}

enum LeadStatut {
  nouveau
  contacte
  converti
  ignore
}

model Invoice {
  id                String           @id @default(cuid())
  numero            String           @unique // ex: INV-XXXXXX (aussi transaction_id CinetPay)
  subscriptionId    String
  etablissementId   String
  montantXAF        Int
  cycle             CycleFacturation
  planCode          Plan             @default(free) // plan demandé pour cette facture
  statut            StatutFacture    @default(en_attente)
  methodePaiement   MethodePaiement?
  referencePaiement String? // transaction_id CinetPay
  urlPaiement       String? // URL de paiement CinetPay
  payeeLe           DateTime?
  createdAt         DateTime         @default(now())

  subscription  Subscription  @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  etablissement Etablissement @relation(fields: [etablissementId], references: [id], onDelete: Cascade)

  @@index([etablissementId, createdAt])
  @@index([statut])
}

// ──────────────────────────────────────────────────────────────────
// BIBLIOTHÈQUE
// ──────────────────────────────────────────────────────────────────

enum CategorieDocument {
  anciennes_epreuves
  rapports_stages
  livres_scientifiques
  cours
  projets
  autre
}

model Document {
  id                String            @id @default(cuid())
  nom               String
  description       String?
  categorie         CategorieDocument @default(autre)
  typeFichier       String // pdf, doc, pptx, etc.
  tailleOctets      Int
  urlFichier        String // chemin de stockage
  thumbnailUrl      String?
  etablissementId   String
  uploadeParId      String
  nbTelechargements Int               @default(0)
  createdAt         DateTime          @default(now())

  etablissement Etablissement @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  uploadePar    User          @relation(fields: [uploadeParId], references: [id], onDelete: Cascade)

  @@index([etablissementId, categorie])
  @@index([nom])
}

// ──────────────────────────────────────────────────────────────────
// SALLE D'EXAMEN
// ──────────────────────────────────────────────────────────────────

enum StatutExamen {
  en_preparation
  en_cours
  termine
  annule
}

enum StatutParticipantExamen {
  connecte
  en_cours
  termine
  invalide
}

model SessionExamen {
  id              String       @id @default(cuid())
  codeInvitation  String       @unique
  titre           String
  matiere         String
  description     String?
  dureeMinutes    Int // durée en minutes
  debut           DateTime?
  fin             DateTime?
  statut          StatutExamen @default(en_preparation)
  profId          String
  etablissementId String
  createdAt       DateTime     @default(now())

  prof          User                @relation(fields: [profId], references: [id])
  etablissement Etablissement       @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  participants  ParticipantExamen[]
  sujets        SujetExamen[]

  @@index([codeInvitation])
  @@index([profId])
}

model ParticipantExamen {
  id             String                  @id @default(cuid())
  sessionId      String
  userId         String
  avertissements Int                     @default(0) // max 5 (caméra) + 3 (quit)
  score          Float?
  statut         StatutParticipantExamen @default(connecte)
  connecteLe     DateTime                @default(now())
  deconnecteLe   DateTime?

  session  SessionExamen   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  reponses ReponseExamen[]

  @@unique([sessionId, userId])
  @@index([sessionId])
}

model SujetExamen {
  id           String @id @default(cuid())
  sessionId    String
  intitule     String
  enonce       String
  typeQuestion String @default("qcm")
  options      Json?
  points       Int    @default(1)
  ordre        Int    @default(0)

  session  SessionExamen   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  reponses ReponseExamen[]

  @@index([sessionId, ordre])
}

model ReponseExamen {
  id            String   @id @default(cuid())
  participantId String
  sujetId       String
  reponse       String // réponse de l'étudiant
  estCorrecte   Boolean?
  pointsObtenus Int?
  reponduLe     DateTime @default(now())

  participant ParticipantExamen @relation(fields: [participantId], references: [id], onDelete: Cascade)
  sujet       SujetExamen       @relation(fields: [sujetId], references: [id], onDelete: Cascade)

  @@unique([participantId, sujetId])
}

// ──────────────────────────────────────────────────────────────────
// CHAT DE GROUPE
// ──────────────────────────────────────────────────────────────────

model GroupeChat {
  id              String   @id @default(cuid())
  nom             String
  codeInvitation  String?  @unique
  photoUrl        String?
  etablissementId String
  classeId        String?
  creeParId       String
  createdAt       DateTime @default(now())

  etablissement Etablissement   @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  creePar       User            @relation(fields: [creeParId], references: [id])
  membres       MembreGroupe[]
  messages      MessageGroupe[]

  @@index([etablissementId])
}

model MembreGroupe {
  id                   String   @id @default(cuid())
  groupId              String
  userId               String
  joinedAt             DateTime @default(now())
  dernierMessageLuLe   DateTime? // horodatage du dernier message de groupe lu par ce membre
                                // → permet de compter les non-lus de façon scalaire (indexé),
                                //   sans recharger tous les messages (évite la requête quadratique)

  groupe GroupeChat @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
}

model MessageGroupe {
  id           String   @id @default(cuid())
  groupId      String
  userId       String
  texte        String
  pieceJointe  Json? // { nom, url, taille, type }
  luPar        Json? // tableau d'ids d'utilisateurs qui ont lu
  createdAt    DateTime @default(now())

  groupe GroupeChat @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([groupId, createdAt])
}

// ──────────────────────────────────────────────────────────────────
// CHAT PRIVÉ (1-à-1 dans le même établissement)
// ──────────────────────────────────────────────────────────────────

model ConversationPrivee {
  id              String   @id @default(cuid())
  userAId         String // initiateur
  userBId         String // invité
  etablissementId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  initiateur User           @relation("ConversationInitiateur", fields: [userAId], references: [id], onDelete: Cascade)
  invite     User           @relation("ConversationInvite", fields: [userBId], references: [id], onDelete: Cascade)
  etablissement Etablissement @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  messages  MessagePrive[]

  @@unique([userAId, userBId])
  @@index([etablissementId])
}

model MessagePrive {
  id             String   @id @default(cuid())
  conversationId String
  userId         String
  texte          String
  pieceJointe    Json? // { nom, url, taille, type }
  lu             Boolean  @default(false)
  createdAt      DateTime @default(now())

  conversation ConversationPrivee @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}
